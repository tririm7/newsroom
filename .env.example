# Newsroom env template.
# For dev: copy to `.env` and fill in (or run scripts/generate-dev-env.sh — M2).
# For prod: installer (M2) generates all values automatically except LLM_API_KEY.

# === Caddy / public address ===
# Dev:  ":80" → HTTP only on localhost
# Prod: your domain, e.g. "news.example.com" — Caddy auto-issues TLS via Let's Encrypt
SITE_ADDRESS=:80

# Used by NextAuth (callback URLs, cookies) — must match SITE_ADDRESS
SITE_URL=http://localhost

# Public-frontend project routing.
# PROJECT_SLUG = the project row's slug in the DB (Open is always "newsroom").
# PROJECT_DEFAULT_LOCALE = which /<locale> path the root '/' redirects to.
PROJECT_SLUG=newsroom
PROJECT_DEFAULT_LOCALE=en

# === Postgres ===
# Auto-generated by installer (patches v1.1 #3).
# For dev, any value works; for prod the installer fills POSTGRES_PASSWORD with `openssl rand -base64 32`.
POSTGRES_DB=newsroom
POSTGRES_USER=newsroom
POSTGRES_PASSWORD=__SET_ME__
DATABASE_URL=postgresql://newsroom:__SET_ME__@postgres:5432/newsroom

# === Auth ===
# 32+ byte random string, auto-generated by installer.
# `openssl rand -base64 32`
NEXTAUTH_SECRET=__SET_ME__

# === LLM provider (v0.2) ===
# One of: deepseek | openai | anthropic | gemini | grok | yandex | openrouter | custom
# See docs/PROVIDERS.md for setup steps + recommended models.
#
# Examples per provider:
#   deepseek    LLM_MODEL=deepseek-chat
#   openai      LLM_MODEL=gpt-4o
#   anthropic   LLM_MODEL=claude-sonnet-4-6
#   gemini      LLM_MODEL=gemini-2.5-flash
#   grok        LLM_MODEL=grok-2-latest
#   yandex      LLM_MODEL=<folder_id>/yandexgpt-latest    (folder + model joined by /)
#   openrouter  LLM_MODEL=anthropic/claude-sonnet-4.6     (any OpenRouter model slug)
#   custom      LLM_MODEL=<your-model>  + set LLM_BASE_URL below
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# Only used when LLM_PROVIDER=custom — your own OpenAI-compatible endpoint URL.
LLM_BASE_URL=

# === Misc ===
NODE_ENV=production
TZ=America/New_York
